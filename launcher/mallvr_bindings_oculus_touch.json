{
  "action_manifest_version": 0,
  "controller_type": "oculus_touch",
  "name": "MallVR - Meta Quest / Oculus Touch",
  "description": "Right stick: up walk, down back, left/right smooth turn. Left stick: up walk, down back, left/right strafe. Hold Y = adjust: left stick up/down = gun aim, right stick left/right = arm reach (Total Recoil: gun nudge). Right trigger fire, B coin + start, A or X game button (hold to crouch in Dactyl Nightmare 1 + 2), left trigger = mode / walk back in Pac-Man. Left stick click: voice chat mute on / off. Keyboard arrows also trim.",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/fire"
            },
            "pull": {
              "output": "/actions/main/in/throttle"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/mode"
            },
            "pull": {
              "output": "/actions/main/in/brake"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move_right"
            },
            "click": {
              "output": "/actions/main/in/mode"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move_left"
            },
            "click": {
              "output": "/actions/main/in/voice_mute"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/aim_press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/top"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/right/output/haptic"
        },
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/left/output/haptic"
        }
      ]
    }
  }
}
