{
  "action_manifest_version": 0,
  "controller_type": "vive_controller",
  "name": "MallVR - Vive wands",
  "description": "Right touchpad: touch up walk, down back, left/right snap turn; click walks. Left touchpad click: up/down aim trim, left/right arm reach (keyboard arrows also trim). Right trigger fire, hold the LEFT menu button to crouch (Dactyl Nightmare 1 + 2), grips snap turn, RIGHT menu button coin + start.",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/fire"
            },
            "pull": {
              "output": "/actions/main/in/throttle"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/main/in/move_right"
            },
            "click": {
              "output": "/actions/main/in/walk"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/main/in/trim_pad"
            },
            "click": {
              "output": "/actions/main/in/trim_press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/turn_left"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/turn_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/menu"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/crouch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/main/in/mode"
            },
            "pull": {
              "output": "/actions/main/in/brake"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/right/output/haptic"
        },
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/left/output/haptic"
        }
      ]
    }
  }
}